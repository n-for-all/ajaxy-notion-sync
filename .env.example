# Copy this file to .env and fill in the values. See README.md for where to find each one.

# --- Shopify app (Dev Dashboard -> your app -> Settings) ---
SHOPIFY_API_KEY=your_client_id
SHOPIFY_API_SECRET=your_client_secret
# Public HTTPS URL of this server, without a trailing slash
SHOPIFY_APP_URL=https://your-app.example.com
SCOPES=read_locales,read_products,read_themes,write_products,read_metaobjects,read_content,read_customers,read_orders,write_orders,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_third_party_fulfillment_orders,write_third_party_fulfillment_orders,read_inventory,write_inventory

# "single_merchant" (default): self-hosted custom app, no billing, no limits.
# "app_store": public App Store app with Shopify billing, plans and review prompts.
APP_DISTRIBUTION=single_merchant

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/notion_sync

# --- Notion (https://www.notion.so/profile/integrations -> your public integration) ---
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret
# Must match the redirect URI set in the Notion integration
NOTION_REDIRECT_URI=https://your-app.example.com/api/notion/callback

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Optional ---
# Hostnames allowed to reach the dev server (e.g. a tunnel), comma separated
# ALLOWED_HOSTS=my-tunnel.example.com
# Where the in-app "Contact us" form is sent (needs sendmail on the server)
# FEEDBACK_EMAIL_TO=you@example.com
# FEEDBACK_EMAIL_FROM=noreply@example.com
# Error reporting with Sentry
# SENTRY_DSN=
# VITE_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Only for APP_DISTRIBUTION=app_store: create test charges
# TEST_PAYMENT=yes
